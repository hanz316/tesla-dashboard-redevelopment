{
  "manifest": "v6-vehicle",
  "version": 2,
  "description": "Vehicle asset source selection + id -> path mapping shared by the device runtime and the Mac previewer. All paths are relative to the SELECTED source root.",
  "canvas": { "width": 356, "height": 236 },
  "vehicle_source": {
    "mode": "auto",
    "production_allows_placeholder": false,
    "active": {
      "rendered_model3": { "root": "assets/rendered/vehicle" },
      "placeholder": { "root": "assets/rendered/placeholder" }
    },
    "notes": [
      "auto: use RENDERED_MODEL3 when a MODEL3_SOURCE.json marker exists, else fall back to PLACEHOLDER for developer preview only.",
      "Production Horizon must run with mode=rendered_model3 (or auto with the marker present)."
    ]
  },
  "images": {
    "vehicle.base": "base/000.png",
    "vehicle.shadow": "base/000.png"
  },
  "sequences": {
    "vehicle.door.fl": {
      "dir": "door_fl",
      "frames": 16,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.door.fr": {
      "dir": "door_fr",
      "frames": 16,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.door.rl": {
      "dir": "door_rl",
      "frames": 16,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.door.rr": {
      "dir": "door_rr",
      "frames": 16,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.frunk": {
      "dir": "frunk",
      "frames": 14,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.trunk": {
      "dir": "trunk",
      "frames": 14,
      "fps": 24,
      "mode": "to_state"
    },
    "vehicle.indicator.left": {
      "dir": "indicator_left",
      "frames": 12,
      "fps": 12,
      "mode": "loop"
    },
    "vehicle.indicator.right": {
      "dir": "indicator_right",
      "frames": 12,
      "fps": 12,
      "mode": "loop"
    },
    "vehicle.hazard": {
      "dir": "hazard",
      "frames": 12,
      "fps": 12,
      "mode": "loop"
    }
  },
  "overlays": {
    "vehicle.brake": "brake_on/000.png",
    "vehicle.headlight": "headlight_on/000.png"
  },
  "notes": [
    "Paths are repo-relative; on device they resolve under the deployed asset root.",
    "Frames are placeholder engineering art until the Blender render replaces them.",
    "Every sequence uses the same 356x236 canvas and anchor (see tools/assets/verify_alignment.py)."
  ]
}
