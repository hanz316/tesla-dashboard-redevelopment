.DS_Store

# --- vehicle asset pipeline ---
# Blender scratch/caches and per-render temp output
assets/**/*.blend1
assets/**/*.blend2
assets/source/blender/*.blend
assets/rendered/**/_supersampled/
*.blend1
*.crash.txt

# Mac previewer output (regenerate with tools/preview/scene_preview.py)
/assets/preview/

# Supersampled intermediates from the Blender render (regenerable, large)
assets/rendered/**/*_ss/

# Downloaded third-party models: never commit (licence + size). Keep the
# SHA-256 in assets/ATTRIBUTION.md instead.
# NOTE: both spellings are listed because the actual directory is
# `download/` (singular) while earlier docs referred to `downloads/`.
assets/source/download/
assets/source/downloads/
assets/source/blender/*_master.blend1

# Real Blender renders of the Model 3 (regenerable, can get large).
# Keep them local; the runtime/previewer read them from here when present.
assets/rendered/vehicle/

# A/B working renders (regenerable). Frozen checkpoint copies live in
# assets/checkpoints/ and ARE committed.
assets/rendered/ab/

# HMI vehicle-visual working renders (full resolution, regenerable).
# Review-sized copies ARE committed under assets/checkpoints/.
assets/rendered/hmi/
