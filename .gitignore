# --- vehicle asset pipeline ---
# Blender scratch/caches and per-render temp output
assets/**/*.blend1
assets/**/*.blend2
assets/source/blender/*.blend
assets/rendered/**/_supersampled/
*.blend1
*.crash.txt

# Mac previewer output (regenerate with tools/preview/scene_preview.py)
/assets/preview/

# Supersampled intermediates from the Blender render (regenerable, large)
assets/rendered/**/*_ss/

# Downloaded third-party models: never commit (licence + size). Keep the
# SHA-256 in assets/ATTRIBUTION.md instead.
# NOTE: both spellings are listed because the actual directory is
# `download/` (singular) while earlier docs referred to `downloads/`.
assets/source/download/
assets/source/downloads/
assets/source/blender/*_master.blend1

# Real Blender renders of the Model 3 (regenerable, can get large).
# Keep them local; the runtime/previewer read them from here when present.
assets/rendered/vehicle/

# A/B working renders (regenerable). Frozen checkpoint copies live in
# assets/checkpoints/ and ARE committed.
assets/rendered/ab/

# HMI vehicle-visual working renders (full resolution, regenerable).
# Review-sized copies ARE committed under assets/checkpoints/.
assets/rendered/hmi/

# Vehicle Visual V2 working renders (2200x1520, regenerable via
# tools/blender/render_v2_checkpoint.sh). Review copies live in
# assets/checkpoints/vehicle_visual_v2_2026-09-16/.
assets/rendered/v2/

# Door_FL benchmark sequences (3 widths x 3 frame rates, regenerable via
# tools/blender/render_door_benchmark.sh). The GIF/MP4/filmstrip review copies
# live in assets/checkpoints/door_fl_2026-09-16/.
assets/rendered/door_fl/

# Vehicle Visual V3 working renders (regenerable; review copies live in
# assets/checkpoints/vehicle_visual_v3_2026-09-16/).
assets/rendered/v3/

# Door_FL V3 working renders + delta POC output (83 MB regenerable; the GIFs,
# filmstrip and one delta example live in assets/checkpoints/door_fl_v3_2026-09-16/).
assets/rendered/door_fl_v3/

# Horizon redesign review renders (regenerable; the committed copies live in
# assets/checkpoints/horizon_redesign_2026-09-16/).
assets/rendered/horizon_redesign/
