      "alpha_when": [
        {
          "when": {
            "signal": "gear",
            "equals": 4
          },
          "alpha": 0.95
        }
      ]
    },
    {
      "id": "energy.ticks",
      "type": "vector",
      "shape": "vticks",
      "z": 42,
      "x": 1746,
      "y": 372,
      "height": 222,
      "count": 25,
      "major_every": 4,
      "width_px": 10,
      "major_width_px": 18,
      "tick_height_px": 2,
      "color": "#1D242C",
      "major_color": "#2C3742",
      "lit_color": "#C9D4DF",
      "progress": {
        "signal": "soc",
        "max": 100
      },
      "alpha_when": [
        {
          "when": {
            "all": [
              {
                "signal": "soc.trusted",
                "is_true": false
              },
              {
                "signal": "soc.valid",
                "valid": true
              }
            ]
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "energy.line",
      "type": "vector",
      "shape": "vbar",
      "z": 42,
      "x": 1712,
      "y": 150,
      "width": 3,
      "height": 222,
      "track_color": "#161C23",
      "radius": 1,
      "opacity": 1.0,
      "progress": {
        "signal": "soc",
        "max": 100,
        "color": "#9FB0BF"
      },
      "alpha_when": [
        {
          "when": {
            "all": [
              {
                "signal": "soc.trusted",
                "is_true": false
              },
              {
                "signal": "soc.valid",
                "valid": true
              }
            ]
          },
          "alpha": 0.0
