      "id": "energy.value",
      "type": "text",
      "z": 40,
      "x": 1676,
      "y": 268,
      "size": 88,
      "align": "right",
      "color": "#EDF1F5",
      "font_role": "display_condensed",
      "font": 88,
      "bind": "soc",
      "format": "{}",
      "invalid_color": "#535D67",
      "invalid_text": "--",
      "alpha_when": [
        {
          "when": {
            "all": [
              {
                "signal": "soc.trusted",
                "is_true": false
              },
              {
                "signal": "soc.valid",
                "valid": true
              }
            ]
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "energy.pct",
      "type": "text",
      "z": 40,
      "x": 1688,
      "y": 290,
      "size": 28,
      "align": "left",
      "color": "#76828E",
      "font_role": "medium",
      "font": 28,
      "text": "%",
      "alpha_when": [
        {
          "when": {
            "all": [
              {
                "signal": "soc.trusted",
                "is_true": false
              },
              {
                "signal": "soc.valid",
                "valid": true
              }
            ]
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "energy.range",
      "type": "text",
      "z": 40,
      "x": 1676,
      "y": 330,
      "size": 26,
      "align": "right",
      "color": "#8A96A2",
      "font_role": "medium",
      "font": 26,
      "tracking": 1.5,
      "bind": "range",
      "format": "{} km",
      "invalid_color": "#5A646E"
    },
    {
      "id": "energy.untrusted",
      "type": "text",
      "z": 40,
      "x": 1676,
      "y": 214,
      "size": 18,
      "align": "right",
      "color": "#8A96A2",
      "font_role": "medium",
      "font": 18,
      "tracking": 2.5,
      "text": "CHARGE EST.",
      "alpha": 0.0,
      "alpha_when": [
        {
          "when": {
            "all": [
              {
                "signal": "soc.trusted",
                "is_true": false
              },
              {
                "signal": "soc.valid",
                "valid": true
              }
            ]
          },
          "alpha": 1.0
        }
      ]
    },
    {
      "id": "ctx.tick",
      "type": "vector",
      "shape": "line",
      "z": 44,
      "x": 1744,
      "y": 386,
      "x2": 1744,
      "y2": 400,
      "color": "#3A3324",
      "width_px": 2,
      "alpha": 0.0,
      "alpha_when": [
        {
          "when": {
            "signal": "door_fl",
            "is_true": true
          },
          "alpha": 1.0
        },
        {
          "when": {
            "signal": "door_fl",
            "valid": true
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "ctx.door",
      "type": "text",
      "z": 40,
      "x": 1732,
      "y": 412,
      "size": 20,
      "align": "right",
      "color": "#CBB27A",
      "font_role": "medium",
      "font": 20,
      "tracking": 4.0,
      "text": "FRONT LEFT DOOR",
      "alpha": 0.0,
      "alpha_when": [
        {
          "when": {
            "signal": "door_fl",
            "is_true": true
          },
          "alpha": 1.0
        },
        {
          "when": {
            "signal": "door_fl",
            "valid": true
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "ctx.uart.tick",
      "type": "vector",
      "shape": "line",
      "z": 44,
      "x": 1744,
      "y": 386,
      "x2": 1744,
      "y2": 400,
      "color": "#3A3224",
      "width_px": 2,
      "alpha": 0.0,
      "alpha_when": [
        {
          "when": {
            "signal": "uart_health",
            "equals": "UART LOST"
          },
          "alpha": 1.0
        },
        {
          "when": {
            "signal": "uart_health",
            "valid": true
          },
          "alpha": 0.0
        }
      ]
    },
    {
      "id": "ctx.uart",
      "type": "text",
      "z": 40,
      "x": 1732,
      "y": 412,
      "size": 20,
      "align": "right",
      "color": "#D8A657",
      "font_role": "medium",
      "font": 20,
      "tracking": 4.0,
      "text": "DRIVE DATA LOST",
      "alpha": 0.0,
      "alpha_when": [
        {
          "when": {
            "signal": "uart_health",
            "equals": "UART LOST"
          },
          "alpha": 1.0
        },
        {
          "when": {
            "signal": "uart_health",
